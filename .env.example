# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_DEMO_MODE: Set to "true" to display the floating development role switcher panel.
# In production, set to "false" so visitors only access portals via standard Sign In.
VITE_DEMO_MODE=false

# Optional development seed accounts (active ONLY when VITE_DEMO_MODE=true)
VITE_DEFAULT_ADMIN_EMAIL="admin@purvaphalguni.com"
VITE_DEFAULT_ADMIN_PASSWORD="your_secure_admin_password_here"
VITE_DEFAULT_AFFILIATE_EMAIL="affiliate@purvaphalguni.com"
VITE_DEFAULT_AFFILIATE_PASSWORD="your_secure_affiliate_password_here"
VITE_DEFAULT_CLIENT_EMAIL="client@purvaphalguni.com"
VITE_DEFAULT_CLIENT_PASSWORD="your_secure_client_password_here"
